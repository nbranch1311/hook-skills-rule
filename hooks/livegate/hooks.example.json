{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "~/.cursor/hooks/livegate/livegate.py",
        "matcher": "Shell",
        "failClosed": false,
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "~/.cursor/hooks/livegate/livegate.py",
        "failClosed": false,
        "timeout": 5
      }
    ]
  }
}
